import React from 'react'
import ReactDOM from 'react-dom/client'
import App from './App.jsx'

// Polyfill window.storage con localStorage para producción
if (!window.storage) {
  window.storage = {
    get: async (key, shared = false) => {
      const storeKey = shared ? `shared_${key}` : `private_${key}`;
      const val = localStorage.getItem(storeKey);
      if (val === null) throw new Error('Key not found');
      return { key, value: val, shared };
    },
    set: async (key, value, shared = false) => {
      const storeKey = shared ? `shared_${key}` : `private_${key}`;
      localStorage.setItem(storeKey, value);
      return { key, value, shared };
    },
    delete: async (key, shared = false) => {
      const storeKey = shared ? `shared_${key}` : `private_${key}`;
      localStorage.removeItem(storeKey);
      return { key, deleted: true, shared };
    },
    list: async (prefix = '', shared = false) => {
      const keys = Object.keys(localStorage)
        .filter(k => k.startsWith(shared ? `shared_${prefix}` : `private_${prefix}`))
        .map(k => k.replace(shared ? 'shared_' : 'private_', ''));
      return { keys, prefix, shared };
    },
  };
}

ReactDOM.createRoot(document.getElementById('root')).render(
  <React.StrictMode>
    <App />
  </React.StrictMode>,
)
